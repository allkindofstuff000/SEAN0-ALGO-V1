[Unit]
Description=SEAN ALGO — live signal outcome resolver (marks WIN/LOSS)
After=network-online.target sean0algo.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sean0algo
EnvironmentFile=/opt/sean0algo/.env
ExecStart=/opt/sean0algo/.venv/bin/python /opt/sean0algo/resolve_outcomes.py
Restart=on-failure
RestartSec=15
StandardOutput=append:/var/log/signal-resolver.log
StandardError=append:/var/log/signal-resolver.log

[Install]
WantedBy=multi-user.target
