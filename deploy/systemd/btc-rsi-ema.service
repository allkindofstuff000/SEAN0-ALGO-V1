[Unit]
Description=SEAN ALGO - BTC RSI EMA live signal bot (24/7)
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sean0algo
Environment=PYTHONPATH=/opt/sean0algo
ExecStart=/opt/sean0algo/.venv/bin/python /opt/sean0algo/btc_rsi_ema_live.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/btc-rsi-ema.log
StandardError=append:/var/log/btc-rsi-ema.log

[Install]
WantedBy=multi-user.target
